{
  "name": "one-dosages",
  "version": "1.0.0",
  "description": "Bilingual (English/Spanish) peptide dosage site built with Next.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4322",
    "build": "node scripts/build-assets.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 4322",
    "lint": "tsc --noEmit",
    "clone:build": "python3 scripts/clone/build.py",
    "check": "tsc --noEmit",
    "assets": "node scripts/build-assets.mjs",
    "predev": "node scripts/build-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katengulati/One-dosages.git"
  },
  "bugs": {
    "url": "https://github.com/katengulati/One-dosages/issues"
  },
  "homepage": "https://github.com/katengulati/One-dosages#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.12",
    "purgecss": "^7.0.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
